[Unit]
Description=Telegram Short Signal Bot Lite
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=<RELEASE_DIR>
Environment=PYTHONUNBUFFERED=1
Environment=AUTOEXECUTION=OFF
ExecStart=<RELEASE_DIR>/.venv/bin/python <RELEASE_DIR>/scripts/run_live.py
Restart=always
RestartSec=10
User=root

[Install]
WantedBy=multi-user.target
