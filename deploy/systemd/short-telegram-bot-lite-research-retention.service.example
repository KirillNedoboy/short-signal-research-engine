[Unit]
Description=Short Bot research retention (bounded and fail-closed)
After=short-telegram-bot-lite.service short-telegram-bot-lite-b.service
Wants=short-telegram-bot-lite.service short-telegram-bot-lite-b.service

[Service]
Type=oneshot
User=root
ExecStart=@REPO_ROOT@/scripts/run_research_retention_dry_run.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=@RESEARCH_ROOT@
ReadOnlyPaths=@LANE_A_ROOT@ @LANE_B_ROOT@ @LANE_C_ROOT@
TimeoutStartSec=8min
